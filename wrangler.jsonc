{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allore-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENV": "production",
    "QDRANT_URL": "https://090c9618-7e77-44f2-94d2-d8d994251c88.eu-central-1-0.aws.cloud.qdrant.io",
    "DODO_PAYMENTS_API_KEY": "wZOidXd9s3mxrqkr.Y_mYl6_Aj3tJI0C97d_q7LURNnmsSflSGLJ97UYF_hv8FxGu",
    "DODO_WEBHOOK_SECRET": "whsec_U5j/R4RM87lrdR0dLTvkPeWFSP6nAf2/"
  },
  "env": {
    "dev": {
      "name": "allore-be-dev",
      "vars": {
        "ENV": "development"
      }
    },
    "production": {
      "name": "allore-be-prod",
      "vars": {
        "ENV": "production"
      }
    }
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "allore-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_LIMITER",
        "class_name": "GlobalLimiter"
      },
      {
        "name": "CHAT_SESSION",
        "class_name": "ChatSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "GlobalLimiter",
        "ChatSession"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CHAT_QUEUE",
        "queue": "allore-chat-logs"
      }
    ]
  }
}