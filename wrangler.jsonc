        "class_name": "ChatSession"
      },
      {
        "name": "RESPONSER",
        "class_name": "Responser"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GlobalLimiter",
        "ChatSession"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Responser"
      ]
    }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": false }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "CHAT_QUEUE",
        "queue": "allore-chat-logs"
      },
      {
        "binding": "LLM_QUEUE",
        "queue": "llm-queue"
      },
      {
        "binding": "IMAGE_QUEUE",
        "queue": "image-gen-queue"
      },
      {
        "binding": "VIDEO_QUEUE",
        "queue": "video-gen-queue"
      }
    ],
    "consumers": [
