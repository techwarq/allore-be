            "class_name": "GlobalLimiter"
          },
          {
            "name": "CHAT_SESSION",
            "class_name": "ChatSession"
          },
          {
            "name": "RESPONSER",
            "class_name": "Responser"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "CHAT_QUEUE",
            "queue": "allore-chat-logs"
          },
          {
            "binding": "LLM_QUEUE",
            "queue": "llm-queue"
          },
          {
            "binding": "IMAGE_QUEUE",
            "queue": "image-gen-queue"
          },
          {
            "binding": "VIDEO_QUEUE",
            "queue": "video-gen-queue"
          }
        ],
        "consumers": [
          {
            "queue": "llm-queue",
            "max_batch_size": 5,
            "max_batch_timeout": 2
          },
          {
            "queue": "image-gen-queue",
            "max_batch_size": 1,
            "max_concurrency": 1
          },
          {
            "queue": "video-gen-queue",
            "max_batch_size": 1
          }
        ]
      }
