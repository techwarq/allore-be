{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allore-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENV": "development",
    "API_URL": "https://allore-be.sonalinayak0804.workers.dev",
    "FRONTEND_URL": "http://localhost:3000",
    "QDRANT_URL": "https://090c9618-7e77-44f2-94d2-d8d994251c88.eu-central-1-0.aws.cloud.qdrant.io",
    "VERTEX_PROJECT_ID": "gg-guidebooks-ai",
    "VERTEX_LOCATION": "us-central1",
    "VERTEX_SERVICE_ACCOUNT_EMAIL": "vertex-express@gg-guidebooks-ai.iam.gserviceaccount.com",
    "IMAGE_GEN_ENABLED": "true",
    "PHOTOSHOOT_IMAGE_GEN_ENABLED": "true"
  },
  "env": {
    "dev": {
      "name": "allore-be-dev",
      "vars": {
        "ENV": "development"
      },
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "allore-assets",
          "preview_bucket_name": "allore-assets"
        }
      ]
    },
    "production": {
      "name": "allore-be-prod",
      "vars": {
        "ENV": "production",
        "API_URL": "https://allore-be-prod.sonalinayak0804.workers.dev",
        "FRONTEND_URL": "https://www.alloreai.com",
        "QDRANT_URL": "https://090c9618-7e77-44f2-94d2-d8d994251c88.eu-central-1-0.aws.cloud.qdrant.io",
        "VERTEX_PROJECT_ID": "gg-guidebooks-ai",
        "VERTEX_LOCATION": "us-central1",
        "VERTEX_SERVICE_ACCOUNT_EMAIL": "vertex-express@gg-guidebooks-ai.iam.gserviceaccount.com",
        "IMAGE_GEN_ENABLED": "true",
        "PHOTOSHOOT_IMAGE_GEN_ENABLED": "true"
      },
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "allore-assets"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GLOBAL_LIMITER",
            "class_name": "GlobalLimiter"
          },
          {
            "name": "CHAT_SESSION",
            "class_name": "ChatSession"
          },
          {
            "name": "RESPONSER",
            "class_name": "Orchestrator"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "CHAT_QUEUE",
            "queue": "allore-chat-logs"
          },
          {
            "binding": "LLM_QUEUE",
            "queue": "llm-queue"
          },
          {
            "binding": "IMAGE_QUEUE",
            "queue": "image-gen-queue"
          },
          {
            "binding": "VIDEO_QUEUE",
            "queue": "video-gen-queue"
          }
        ],
        "consumers": [
          {
            "queue": "llm-queue",
            "max_batch_size": 5,
            "max_batch_timeout": 2
          },
          {
            "queue": "image-gen-queue",
            "max_batch_size": 1,
            "max_concurrency": 1
          },
          {
            "queue": "video-gen-queue",
            "max_batch_size": 1
          }
        ]
      }
    }
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "allore-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_LIMITER",
        "class_name": "GlobalLimiter"
      },
      {
        "name": "CHAT_SESSION",
        "class_name": "ChatSession"
      },
      {
        "name": "RESPONSER",
        "class_name": "Orchestrator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GlobalLimiter",
        "ChatSession"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Responser"
      ]
    },
    {
      "tag": "v3",
      "renamed_classes": [
        { "from": "Responser", "to": "Orchestrator" }
      ]
    }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": false }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "CHAT_QUEUE",
        "queue": "allore-chat-logs"
      },
      {
        "binding": "LLM_QUEUE",
        "queue": "llm-queue"
      },
      {
        "binding": "IMAGE_QUEUE",
        "queue": "image-gen-queue"
      },
      {
        "binding": "VIDEO_QUEUE",
        "queue": "video-gen-queue"
      }
    ],
    "consumers": [
      {
        "queue": "llm-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 2
      },
      {
        "queue": "image-gen-queue",
        "max_batch_size": 1,
        "max_concurrency": 1
      },
      {
        "queue": "video-gen-queue",
        "max_batch_size": 1
      }
    ]
  }
}