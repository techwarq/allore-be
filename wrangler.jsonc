        "queue": "llm-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 2
      },
      {
        "queue": "image-gen-queue",
        "max_batch_size": 1,
        "max_concurrency": 1
      },
      {
        "queue": "video-gen-queue",
        "max_batch_size": 1
      }
